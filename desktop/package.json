{
  "name": "harpia-desktop",
  "productName": "Harpia",
  "version": "0.1.0",
  "private": true,
  "description": "App de computador do Harpia: o workspace da equipe numa janela própria.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "setup": "npm install && node node_modules/electron/install.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "check": "npm run typecheck && npm test && npm run build",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "dev.harpia.desktop",
    "productName": "Harpia",
    "copyright": "Harpia",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "static/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "Harpia"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "syncDesktopName": true
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jeannnn19233-cyber/harpia.git",
    "directory": "desktop"
  },
  "author": "Harpia",
  "desktopName": "harpia.desktop"
}
