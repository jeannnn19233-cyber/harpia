# Copie para /etc/harpia.env e ajuste.

# Escuta só na própria máquina. O acesso da equipe chega pelo tailscale serve.
HARPIA_HOST=127.0.0.1
HARPIA_PORT=7420

# Banco de dados e repositórios clonados.
HARPIA_DATA_DIR=/var/lib/harpia

# Endereço HTTPS que o tailscale serve mostra (sem barra no fim).
HARPIA_ALLOWED_ORIGINS=https://harpia.SEU-TAILNET.ts.net
HARPIA_COOKIE_SECURE=true

# Código exigido para criar a primeira conta (o administrador). Gere com: openssl rand -base64 24
HARPIA_SETUP_CODE=

# Token do GitHub para clonar repositórios privados (opcional).
HARPIA_GITHUB_TOKEN=

HARPIA_LOG_LEVEL=info
